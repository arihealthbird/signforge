# AI Provider Configuration
# Option 1 (recommended): Use Kimi K2.5 via OpenRouter
AI_API_KEY=sk-or-your-openrouter-api-key
# AI_BASE_URL=https://openrouter.ai/api/v1       # default when AI_API_KEY is set
# AI_MODEL=moonshotai/kimi-k2.5                   # default when AI_API_KEY is set

# Option 2: Use Moonshot API directly
# AI_API_KEY=sk-your-moonshot-api-key
# AI_BASE_URL=https://api.moonshot.ai/v1
# AI_MODEL=kimi-k2.5

# Option 3 (legacy): Use OpenAI (fallback if AI_API_KEY is not set)
# OPENAI_API_KEY=sk-your-openai-api-key

# Cloudflare R2 Storage (required for image uploads)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=signature-forge

# Public URL for R2 bucket (set up a custom domain or use R2.dev subdomain)
# Enable public access in R2 bucket settings and configure a custom domain
R2_PUBLIC_URL=https://assets.yourdomain.com

# Giphy API Key (for GIF picker)
# Get your API key from https://developers.giphy.com/
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-api-key

# Cloudflare Turnstile (bot protection - optional)
# Get your keys from https://dash.cloudflare.com/?to=/:account/turnstile
# If not set, bot protection is disabled and all requests are allowed
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Upstash Redis (distributed rate limiting - recommended for production)
# Get your credentials from https://console.upstash.com/
# If not set, falls back to in-memory rate limiting (resets on deploy)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
