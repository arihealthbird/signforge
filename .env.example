# ── AI orchestration (Theo by HiTheo) ───────────────────────────────────
# SignForge designs signatures with Theo, the AI orchestration API at
# https://hitheo.ai. Create a key in the dashboard (guide:
# https://docs.hitheo.ai/quickstart/get-api-key) and paste it here. The key is
# server-only: never give it a NEXT_PUBLIC_ prefix.
#
# Keep real values out of shell history, chat and screenshots. A vault such as
# AIRCTRL (https://airctrl.dev) stores keys and environment variables encrypted
# and scoped by project and environment.
THEO_API_KEY=your-theo-api-key

# Optional overrides (defaults shown):
# THEO_BASE_URL=https://www.hitheo.ai   # https only
# THEO_MODE=fast                        # fast, or think for deeper reasoning

# ── GIFs (GIPHY, optional) ──────────────────────────────────────────────
# Enables the GIF picker and lets the AI suggest GIFs. Create a free key at
# https://developers.giphy.com. GIPHY keys are designed to be public, so this
# one is read in the browser (hence NEXT_PUBLIC_). Leave it unset to hide the
# GIF picker; people can still paste a GIF URL by hand.
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-api-key

# ── Scene backdrops (optional) ──────────────────────────────────────────
# Some scenes can show a short looping video behind the preview window. No
# media ships with this repo. If you host your own re-encoded loops (see the
# README), point this at the folder's https URL. Files are named after the
# scene, for example pirate.mp4 and pirate.jpg. Leave it unset and every
# scene uses its canvas effect, with no extra request.
# NEXT_PUBLIC_SCENE_MEDIA_BASE=https://cdn.example.com/signforge-scenes

# ── Rate limiting (optional) ────────────────────────────────────────────
# AI requests are limited per visitor address. On Vercel nothing is needed.
# Behind another proxy or CDN, name the one header it sets or overwrites with
# the visitor's address, never a header a visitor can send themselves. For
# example cf-connecting-ip behind Cloudflare, or x-real-ip behind nginx.
# TRUSTED_IP_HEADER=cf-connecting-ip
